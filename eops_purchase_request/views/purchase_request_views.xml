<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eops_purchase_request_list" model="ir.ui.view">
        <field name="name">eops.purchase.request.list</field>
        <field name="model">eops.purchase.request</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'approved'"
                  decoration-warning="state == 'submitted'"
                  decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="request_date"/>
                <field name="requester_id"/>
                <field name="department_id"/>
                <field name="amount_total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="approver_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_eops_purchase_request_form" model="ir.ui.view">
        <field name="name">eops.purchase.request.form</field>
        <field name="model">eops.purchase.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit"
                            type="object"
                            string="Submit"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_approve"
                            type="object"
                            string="Approve"
                            class="btn-primary"
                            groups="eops_core.group_eops_user"
                            invisible="state != 'submitted'"/>

                    <button name="action_reject"
                            type="object"
                            string="Reject"
                            invisible="state != 'submitted'"
                            groups="eops_core.group_eops_user"/>

                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            invisible="state not in ['draft', 'submitted']"/>

                    <button name="action_reset_to_draft"
                            type="object"
                            string="Reset to Draft"
                            groups="eops_core.group_eops_manager"
                            invisible="state not in ['rejected', 'cancelled']"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,submitted,approved,rejected,cancelled"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="True"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="requester_id"
                                   readonly="state != 'draft'"/>
                            <field name="department_id"
                                   readonly="state != 'draft'"/>
                            <field name="request_date"
                                   readonly="state != 'draft'"/>
                            <field name="required_date"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="company_id"
                                   readonly="state != 'draft'"/>
                            <field name="currency_id"/>
                            <field name="approver_id"/>
                            <field name="approval_policy_id"/>
                            <field name="amount_total"/>
                        </group>
                    </group>

                    <group>
                        <field name="reason"
                               readonly="state != 'draft'"/>
                        <field name="rejection_reason"
                               readonly="True"
                               invisible="not rejection_reason"/>
                    </group>

                    <notebook>
                        <page string="Products" name="products">
                            <field name="line_ids"
                                   readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="product_uom_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="currency_id"
                                           column_invisible="True"/>
                                    <field name="subtotal" sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_eops_purchase_request_search" model="ir.ui.view">
        <field name="name">eops.purchase.request.search</field>
        <field name="model">eops.purchase.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="requester_id"/>
                <field name="department_id"/>
                <field name="approver_id"/>

                <filter name="filter_draft"
                        string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_submitted"
                        string="Submitted"
                        domain="[('state', '=', 'submitted')]"/>
                <filter name="filter_approved"
                        string="Approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter name="filter_rejected"
                        string="Rejected"
                        domain="[('state', '=', 'rejected')]"/>

                <group>
                    <filter name="group_by_state"
                            string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_by_department"
                            string="Department"
                            context="{'group_by': 'department_id'}"/>
                    <filter name="group_by_requester"
                            string="Requester"
                            context="{'group_by': 'requester_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eops_purchase_request"
            model="ir.actions.act_window">
        <field name="name">Purchase Requests</field>
        <field name="res_model">eops.purchase.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id"
               ref="view_eops_purchase_request_search"/>
    </record>

    <menuitem id="menu_eops_purchase_requests"
              name="Purchase Requests"
              parent="eops_core.menu_eops_root"
              action="action_eops_purchase_request"
              sequence="10"
              groups="eops_core.group_eops_user"/>
</odoo>