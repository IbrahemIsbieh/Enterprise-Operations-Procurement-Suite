<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eops_department_list" model="ir.ui.view">
        <field name="name">eops.department.list</field>
        <field name="model">eops.department</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="manager_id"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_eops_department_form" model="ir.ui.view">
        <field name="name">eops.department.form</field>
        <field name="model">eops.department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="manager_id"/>
                        <field name="company_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eops_department_search" model="ir.ui.view">
        <field name="name">eops.department.search</field>
        <field name="model">eops.department</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="manager_id"/>
                <filter name="active_departments"
                        string="Active"
                        domain="[('active', '=', True)]"/>
                <filter name="archived_departments"
                        string="Archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_company"
                            string="Company"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eops_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">eops.department</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id"
               ref="view_eops_department_search"/>
    </record>
</odoo>