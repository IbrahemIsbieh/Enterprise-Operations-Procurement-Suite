<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eops_procurement_tender_list" model="ir.ui.view">
        <field name="name">eops.procurement.tender.list</field>
        <field name="model">eops.procurement.tender</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'awarded'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="purchase_request_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="selected_vendor_line_id"/>
                <field name="selected_purchase_order_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'rfqs_created'"
                       decoration-success="state == 'awarded'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_eops_procurement_tender_form" model="ir.ui.view">
        <field name="name">eops.procurement.tender.form</field>
        <field name="model">eops.procurement.tender</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_rfqs"
                            type="object"
                            string="Create Supplier RFQs"
                            class="btn-primary"
                            groups="eops_core.group_eops_manager"
                            invisible="state != 'draft'"/>

                    <button name="action_award_tender"
                            type="object"
                            string="Award Tender"
                            class="btn-primary"
                            groups="eops_core.group_eops_manager"
                            invisible="state != 'rfqs_created'"/>

                    <button name="action_view_selected_purchase_order"
                            type="object"
                            string="View Selected RFQ"
                            invisible="not selected_purchase_order_id"/>

                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            groups="eops_core.group_eops_manager"
                            invisible="state in ('awarded', 'cancelled')"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,rfqs_created,awarded,cancelled"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="purchase_request_id"
                                   readonly="state != 'draft'"
                                   domain="[('state', '=', 'approved'), ('company_id', '=', company_id)]"/>
                            <field name="company_id"
                                   readonly="state != 'draft'"
                                   groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="True"/>
                        </group>
                        <group>
                            <field name="selected_vendor_line_id"
                                   readonly="True"/>
                            <field name="selected_purchase_order_id"
                                   readonly="True"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Supplier Quotations">
                            <field name="vendor_line_ids"
                                   readonly="state in ('awarded', 'cancelled')">
                                <list editable="bottom"
                                      create="1"
                                      delete="1">
                                    <field name="vendor_id"
                                           readonly="parent.state != 'draft'"/>
                                    <field name="purchase_order_id"
                                           readonly="True"/>
                                    <field name="amount_total"
                                           readonly="True"/>
                                    <field name="is_selected"
                                           readonly="parent.state != 'rfqs_created'"/>
                                </list>
                            </field>
                        </page>

                        <page string="Notes">
                            <field name="notes"
                                   readonly="state in ('awarded', 'cancelled')"/>
                        </page>
                    </notebook>

                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eops_procurement_tender_search" model="ir.ui.view">
        <field name="name">eops.procurement.tender.search</field>
        <field name="model">eops.procurement.tender</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="purchase_request_id"/>
                <field name="selected_vendor_line_id"/>

                <filter name="filter_draft"
                        string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_rfqs_created"
                        string="RFQs Created"
                        domain="[('state', '=', 'rfqs_created')]"/>
                <filter name="filter_awarded"
                        string="Awarded"
                        domain="[('state', '=', 'awarded')]"/>
                <filter name="filter_cancelled"
                        string="Cancelled"
                        domain="[('state', '=', 'cancelled')]"/>

                <separator/>

                <filter name="group_by_state"
                        string="Group by Status"
                        context="{'group_by': 'state'}"/>
                <filter name="group_by_company"
                        string="Group by Company"
                        context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_eops_procurement_tender" model="ir.actions.act_window">
        <field name="name">Procurement Tenders</field>
        <field name="res_model">eops.procurement.tender</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_eops_procurement_tender_search"/>
    </record>

    <menuitem id="menu_eops_procurement_root"
              name="Procurement"
              sequence="30"
              groups="eops_core.group_eops_user"/>

    <menuitem id="menu_eops_procurement_tenders"
              name="Supplier Tenders"
              parent="menu_eops_procurement_root"
              action="action_eops_procurement_tender"
              sequence="10"
              groups="eops_core.group_eops_user"/>
</odoo>
